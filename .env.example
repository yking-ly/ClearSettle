# Safe defaults: the app works in clearly labeled demo mode without credentials.
DEMO_MODE=true

# Neon Auth. Generate the cookie secret with: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Comma-separated emails allowed to access this merchant workspace.
AUTH_ALLOWED_EMAILS=

# AI extraction. Keep this server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Personalized collection reminders through Resend. Keep the key server-side.
RESEND_API_KEY=
REMINDER_FROM_EMAIL="ClearSettle <reminders@your-verified-domain.example>"
# Optional in Sandbox: route fake PayPal buyer addresses to your real test inbox.
REMINDER_TEST_RECIPIENT=

# PayPal Sandbox. Keep the secret server-side.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# PostgreSQL. Required before real PayPal writes or webhook ingestion.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clearsettle
